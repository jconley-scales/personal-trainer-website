# Copy this file to .env and adjust values for your deployment.

PORT=4000

# Password required to access the Admin dashboard. Change this before deploying!
ADMIN_PASSWORD=changeme123

# Business/sender identity used on confirmation emails.
BUSINESS_NAME=Bright Path Personal Training
FROM_EMAIL=no-reply@brightpathtraining.example

# Real SMTP delivery is optional. Without these, the server "sends" email by
# writing the message to server/data/sent-emails.log and to the console, so
# booking/cancellation confirmations still work out of the box in development.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
